        {
          "id": "659754e2-c0fa-411b-b3f4-6ca5334a2b58",
          "name": "Discover all favicons from a URL",
          "request": {
            "name": "Discover all favicons from a URL",
            "description": {
              "content": "Parses a page's `<link>` tags and returns every favicon/icon found\n(apple-touch-icon, icon, shortcut icon, etc.) as structured JSON,\nwith document order preserved. Includes a best-guess recommendation\nand a /favicon.ico fallback flag when no link-rel icons exist.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "favicon-extractor"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) Target URL to analyze (must include http:// or https://)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
